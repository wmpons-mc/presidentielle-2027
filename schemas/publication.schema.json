{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "1.0.0"
        },
        "state": {
          "type": "string",
          "const": "unavailable"
        }
      },
      "required": [
        "schemaVersion",
        "state"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "1.0.0"
        },
        "state": {
          "type": "string",
          "const": "available"
        },
        "fixture": {
          "type": "boolean"
        },
        "datasetSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "method": {
          "type": "object",
          "properties": {
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "definitions": {
              "$ref": "#/$defs/__schema0"
            },
            "sources": {
              "$ref": "#/$defs/__schema0"
            },
            "limits": {
              "$ref": "#/$defs/__schema0"
            },
            "workflow": {
              "$ref": "#/$defs/__schema0"
            },
            "references": {
              "maxItems": 30,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema2"
              }
            }
          },
          "required": [
            "version",
            "definitions",
            "sources",
            "limits",
            "workflow",
            "references"
          ],
          "additionalProperties": false
        },
        "responsibility": {
          "$ref": "#/$defs/__schema0"
        },
        "funding": {
          "$ref": "#/$defs/__schema0"
        },
        "lastSuccessfulCollection": {
          "$ref": "#/$defs/__schema3"
        },
        "collectionScope": {
          "$ref": "#/$defs/__schema1"
        },
        "lastPublication": {
          "$ref": "#/$defs/__schema3"
        },
        "corrections": {
          "maxItems": 10000,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema5"
          }
        }
      },
      "required": [
        "schemaVersion",
        "state",
        "fixture",
        "datasetSha256",
        "method",
        "responsibility",
        "funding",
        "lastSuccessfulCollection",
        "collectionScope",
        "lastPublication",
        "corrections"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "title": {
          "$ref": "#/$defs/__schema1"
        },
        "paragraphs": {
          "minItems": 1,
          "maxItems": 30,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        }
      },
      "required": [
        "title",
        "paragraphs"
      ],
      "additionalProperties": false
    },
    "__schema1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000,
      "pattern": "\\S"
    },
    "__schema2": {
      "type": "object",
      "properties": {
        "title": {
          "$ref": "#/$defs/__schema1"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "title",
        "url"
      ],
      "additionalProperties": false
    },
    "__schema3": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "known"
            },
            "value": {
              "$ref": "#/$defs/__schema4"
            }
          },
          "required": [
            "state",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "unknown"
            }
          },
          "required": [
            "state"
          ],
          "additionalProperties": false
        }
      ]
    },
    "__schema4": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "__schema5": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema6"
        },
        "kind": {
          "type": "string",
          "const": "editorial_correction"
        },
        "publishedAt": {
          "$ref": "#/$defs/__schema4"
        },
        "summary": {
          "$ref": "#/$defs/__schema1"
        },
        "collection": {
          "type": "string",
          "enum": [
            "actors",
            "topics",
            "questions",
            "sources",
            "propositions"
          ]
        },
        "before": {
          "$ref": "#/$defs/__schema7"
        },
        "after": {
          "$ref": "#/$defs/__schema7"
        }
      },
      "required": [
        "id",
        "kind",
        "publishedAt",
        "summary",
        "collection",
        "before",
        "after"
      ],
      "additionalProperties": false
    },
    "__schema6": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,119}$"
    },
    "__schema7": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema6"
        },
        "version": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    }
  },
  "$id": "https://wmpons-mc.github.io/presidentielle-2027/schemas/publication.schema.json"
}
