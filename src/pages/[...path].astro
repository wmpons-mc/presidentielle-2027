---
import SiteLayout from '../layouts/SiteLayout.astro';
import EmptyState from '../components/EmptyState.astro';
import QuestionPicker from '../components/QuestionPicker.astro';
import RecordDetails from '../components/RecordDetails.astro';
import { loadCatalog } from '../site/load.ts';
import { recordLabel, recordPath } from '../site/catalog.ts';
import { sitePages, sourceIndex } from '../site/pages.ts';
import type { SitePage } from '../site/pages.ts';
export function getStaticPaths() { return sitePages(loadCatalog()).map(page => ({params:{path:page.path},props:{page}})); }
interface Props { page:SitePage; }
const {page} = Astro.props;
const catalog = loadCatalog();
const indexRecords = page.type === 'index' ? (page.collection === 'sources' ? sourceIndex(catalog) : catalog.current[page.collection]).filter(r => page.collection !== 'actors' || ('kind' in r && r.kind === 'person')) : [];
---
<SiteLayout title={page.title}>
  <header class="page-header"><p class="breadcrumb"><a href="/">Accueil</a> / {page.type === 'record' ? <a href={recordPath(page.collection,page.record).split('/').slice(0,2).join('/')+'/'}>Parcourir les fiches</a> : page.title}</p><h1>{page.title}</h1></header>
  {page.type === 'index' && <>
    {page.collection === 'questions' && <QuestionPicker catalog={catalog} />}
    <p class="lede">{page.collection === 'actors' ? 'Retrouvez les personnalités documentées et leur statut de candidature daté. Une présence ici ne vaut pas candidature officielle.' : page.collection === 'questions' ? 'Choisissez une question pour retrouver les informations disponibles et leur couverture.' : page.collection === 'topics' ? 'Les thèmes rassemblent les questions publiées. Ce périmètre évolue avec les sources examinées.' : page.collection === 'propositions' ? 'Mesures, objectifs et éléments de contexte restent distingués dans chaque détail. Leur présence ne vaut pas attribution personnelle.' : 'Les documents cités sont identifiés par version. Leur présence ne garantit pas une couverture exhaustive.'}</p>
    {indexRecords.length ? <ul class="record-list">{indexRecords.map(record => <li><a href={recordPath(page.collection,record)}>{recordLabel(record)} <span aria-hidden="true">→</span></a>{page.collection === 'sources' && <p>Version {record.version} consultée</p>}</li>)}</ul> : <EmptyState />}
  </>}
  {page.type === 'record' && <RecordDetails page={page} catalog={catalog} />}
  {page.type === 'method' && <article class="prose"><p class="lede">Comprendre ce qui est documenté, et ce qui ne l’est pas encore.</p><h2>Partir d’une question précise</h2><p>Les propositions sont rattachées à des questions et à des sources identifiables. Un objectif général, un diagnostic et une mesure concrète ne se confondent pas.</p><h2>Garder les nuances</h2><p>Une information inconnue n’est ni un zéro ni une opposition. Une mesure non trouvée dans les documents examinés ne signifie pas qu’elle n’existe dans aucun autre document.</p><h2>Retrouver la bonne version</h2><p>Les fiches et les sources possèdent des liens vers des versions précises. Le statut de candidature d’une personne est daté et distinct de la disponibilité de sa fiche.</p><h2>Un périmètre encore en préparation</h2><p>La comparaison suit l’ordre alphabétique des noms, puis les identifiants stables en cas d’égalité. Les filtres utilisent le périmètre actif et sont conservés dans le lien partagé. Les mesures et objectifs personnellement attribués sont séparés des éléments de contexte. Les versions publiques disponibles distinguent les corrections éditoriales des évolutions politiques ; aucun historique exhaustif n’est revendiqué.</p><a class="text-link" href="/sources/">Parcourir les sources disponibles →</a></article>}
</SiteLayout>
