---
import SiteLayout from '../layouts/SiteLayout.astro';
import EmptyState from '../components/EmptyState.astro';
import { loadCatalog } from '../site/load.ts';
import { recordPath } from '../site/catalog.ts';
const {current} = loadCatalog();
---
<SiteLayout title="Comprendre les propositions">
  <section class="hero"><p class="eyebrow">Présidentielle française · 2027</p><h1>Partir des questions.<br /><em>Revenir aux sources.</em></h1><p class="lede">Explorer les propositions par sujet ou par candidat, avec leurs sources et leurs limites. Pour se faire une idée, sans classement des personnes.</p><div class="actions"><a class="button" href="/questions/">Explorer les questions <span aria-hidden="true">→</span></a><a class="text-link" href="/methode/">Comment lire ces informations</a></div></section>
  <section aria-labelledby="topics-title"><div class="section-heading"><div><p class="eyebrow">Choisir un point d’entrée</p><h2 id="topics-title">Les sujets, avant les étiquettes</h2></div><a href="/candidats/">Parcourir les candidats <span aria-hidden="true">→</span></a></div>
    {current.topics.length ? <ul class="card-grid">{current.topics.map((topic,i) => <li><a class="card" href={recordPath('topics',topic)}><span class="card-number" aria-hidden="true">{String(i+1).padStart(2,'0')}</span><h3>{topic.label}</h3><p>{current.questions.filter(q => q.topicRef.id === topic.id).length} question(s) publiée(s)</p><span class="card-arrow" aria-hidden="true">↗</span></a></li>)}</ul> : <EmptyState title="Les premiers sujets sont en préparation">Aucune fiche politique n’est publiée à ce stade. Les questions et candidats apparaîtront ici après validation.</EmptyState>}
  </section>
  <section class="reading-note"><h2>Une lecture attentive, pas un palmarès.</h2><p>Une proposition sourcée, une information encore inconnue et une mesure non trouvée dans un corpus sont trois situations différentes. Nous les distinguons.</p><a href="/sources/">Consulter les sources disponibles →</a></section>
</SiteLayout>
