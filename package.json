{
  "name": "presidentielle-2027",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.11.1 <25"
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "schemas": "node scripts/generate-schemas.ts",
    "schemas:check": "node scripts/generate-schemas.ts --check",
    "check": "npm run typecheck && npm run check:astro && npm test && npm run schemas:check",
    "validate:content": "node scripts/validate-content.ts",
    "dev": "node scripts/astro.ts dev --host 127.0.0.1",
    "build": "node scripts/astro.ts build",
    "preview": "node scripts/astro.ts preview --host 127.0.0.1",
    "build:demo": "node scripts/build-demo.ts",
    "check:astro": "node scripts/astro.ts check --tsconfig tsconfig.astro.json",
    "test:site": "node scripts/test-site-build.ts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "astro": "7.3.2",
    "zod": "4.6.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.4",
    "typescript": "6.0.3"
  }
}
