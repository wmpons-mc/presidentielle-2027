{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "erasableSyntaxOnly": true
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "src/**/*.astro",
    ".astro/types.d.ts",
    "playwright.config.ts"
  ],
  "extends": "astro/tsconfigs/strict",
  "exclude": [
    "dist",
    "dist-demo"
  ]
}
